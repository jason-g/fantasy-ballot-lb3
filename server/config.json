{
  "restApiRoot": "/api",
  "host": "0.0.0.0",
  "port": 3069,
  "remoting": {
    "context": false,
    "rest": {
      "handleErrors": false,
      "normalizeHttpPath": false,
      "xml": false
    },
    "json": {
      "strict": false,
      "limit": "100kb"
    },
    "urlencoded": {
      "extended": true,
      "limit": "100kb"
    },
    "cors": {
      "origin": false,
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"],
      "allowedHeaders": ["Content-Type", "Authorization"],
      "exposedHeaders": ["Content-Range", "X-Content-Range"],
      "credentials": true,
      "maxAge": 86400
    }
  }
}
